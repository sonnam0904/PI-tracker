# Database driver: sqlite | postgres | mysql
DB_DRIVER=sqlite

# sqlite
DB_SQLITE_PATH=taskmanager.db

# postgres / mysql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=taskmanager
DB_SCHEMA=

# ---- Gợi ý estimate bằng AI (tùy chọn) ----
# Bật tính năng bằng cách đặt AI_PROVIDER + AI_API_KEY. Bỏ trống = tắt.
# AI_PROVIDER: anthropic | openai | qwen | deepseek | glm | gemini
AI_PROVIDER=
AI_API_KEY=
# AI_MODEL: bỏ trống để dùng model mặc định của provider. Ví dụ mặc định:
#   openai=gpt-4o-mini  deepseek=deepseek-chat  qwen=qwen-plus
#   glm=glm-4-flash  gemini=gemini-1.5-flash  anthropic=claude-3-5-haiku-latest
AI_MODEL=
# AI_BASE_URL: chỉ đặt khi cần trỏ qua endpoint riêng/proxy (bỏ trống = mặc định).
AI_BASE_URL=
