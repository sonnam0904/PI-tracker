# Database driver: sqlite | postgres | mysql
DB_DRIVER=sqlite

# sqlite
DB_SQLITE_PATH=taskmanager.db

# postgres / mysql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=taskmanager
DB_SCHEMA=

# Log SQL: silent (mặc định) | error | warn | info
#   info = in MỌI câu SQL ra stdout — dùng khi cần soi truy vấn lúc phát triển
#   warn = chỉ câu chậm + lỗi
# Chạy `wails dev` thì log hiện ở terminal đang chạy nó.
DB_LOG=silent
# Ngưỡng đánh dấu SLOW SQL, mili-giây (mặc định 200). Chỉ có tác dụng từ warn trở lên.
DB_SLOW_QUERY_MS=200
